{
  "name": "programming-quotes",
  "version": "0.1.0",
  "homepage": "https://skolakoda.github.io/programming-quotes",
  "repository": "https://github.com/skolakoda/programming-quotes",
  "license": "MIT",
  "scripts": {
    "save": "wget https://programming-quotes-api.herokuapp.com/quotes/ -d src/data/quotes.json",
    "predeploy": "npm run build",
    "start": "vite",
    "start:server": "vite --mode server",
    "build": "vite build",
    "build:server": "vite build --mode server",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "gh-pages": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.4",
    "react-stars": "^2.2.5",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "node-wget": "^0.4.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
